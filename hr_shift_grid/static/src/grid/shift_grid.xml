<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="hr_shift_grid.ShiftGridAction">
        <div class="o_hr_shift_grid o_action h-100" t-on-click="this.onRootClick">
            <t t-if="this.state.data">
                <div class="o_hr_shift_grid_scroll">
                    <table class="table table-sm o_hr_shift_grid_table">
                        <thead>
                            <tr>
                                <th class="o_hr_shift_grid_employee_col">Employee</th>
                                <th
                                    t-foreach="this.state.data.days"
                                    t-as="day"
                                    t-key="day.day_number"
                                    t-attf-class="o_hr_shift_grid_day_col text-center {{ day.is_today ? 'o_hr_shift_grid_today' : '' }}"
                                >
                                    <div
                                        class="o_hr_shift_grid_day_name"
                                        t-out="day.label"
                                    />
                                    <div
                                        class="o_hr_shift_grid_day_date text-muted"
                                        t-out="day.date_label"
                                    />
                                </th>
                                <th
                                    class="o_hr_shift_grid_hours_col text-end"
                                >Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-foreach="this.state.data.groups"
                                t-as="group"
                                t-key="group.id"
                            >
                                <tr class="o_hr_shift_grid_group">
                                    <td colspan="9" t-out="group.name" />
                                </tr>
                                <tr
                                    t-foreach="group.employees"
                                    t-as="employee"
                                    t-key="employee.employee_id"
                                >
                                    <td class="o_hr_shift_grid_employee">
                                        <img
                                            class="o_hr_shift_grid_avatar rounded-circle"
                                            t-attf-src="/web/image/hr.employee/{{ employee.employee_id }}/avatar_128"
                                            alt=""
                                        />
                                        <span t-out="employee.name" />
                                    </td>
                                    <t
                                        t-foreach="this.state.data.days"
                                        t-as="day"
                                        t-key="day.day_number"
                                    >
                                        <t
                                            t-set="lines"
                                            t-value="this.cellLines(employee, day)"
                                        />
                                        <td
                                            t-att-class="this.cellClass(lines, day)"
                                            t-on-click="(ev) => this.onCellClick(ev, employee, day)"
                                            t-on-dragover="(ev) => this.onDragOver(ev, lines)"
                                            t-on-dragenter="(ev) => this.onDragEnter(ev, lines)"
                                            t-on-dragleave="this.onDragLeave"
                                            t-on-drop="(ev) => this.onDrop(ev, employee, day)"
                                        >
                                            <t t-if="!lines.length">
                                                <span
                                                    class="o_hr_shift_grid_off text-muted"
                                                >—</span>
                                            </t>
                                            <div
                                                t-else=""
                                                class="o_hr_shift_grid_cell_stack"
                                            >
                                                <t
                                                    t-foreach="lines"
                                                    t-as="cell"
                                                    t-key="cell.line_id"
                                                >
                                                    <t t-if="this.isLocked(cell)">
                                                        <span
                                                            class="o_hr_shift_grid_chip o_hr_shift_grid_leave badge rounded-pill"
                                                        >Leave</span>
                                                    </t>
                                                    <t t-elif="cell.template_id">
                                                        <span
                                                            t-attf-class="o_tag o_badge badge rounded-pill o_tag_color_{{ cell.color }} o_hr_shift_grid_chip"
                                                            draggable="true"
                                                            t-att-title="day.label"
                                                            t-on-click="(ev) => this.onChipClick(ev, employee, day, cell)"
                                                            t-on-dragstart="(ev) => this.onDragStart(ev, cell)"
                                                            t-on-dragend="this.onDragEnd"
                                                        >
                                                            <b t-out="cell.code" />
                                                        </span>
                                                    </t>
                                                </t>
                                                <span
                                                    t-if="this.hasEditableLine(lines)"
                                                    t-att-class="this.addIconClass(lines)"
                                                    data-icon="add"
                                                    role="img"
                                                    aria-label="Assign a shift"
                                                />
                                            </div>
                                        </td>
                                    </t>
                                    <td
                                        class="o_hr_shift_grid_hours text-end fw-bold"
                                        t-out="this.formatHours(employee.hours)"
                                    />
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr class="o_hr_shift_grid_foot">
                                <td class="text-muted">Assigned</td>
                                <td
                                    t-foreach="this.state.data.days"
                                    t-as="day"
                                    t-key="day.day_number"
                                    t-attf-class="text-center {{ day.is_today ? 'o_hr_shift_grid_today' : '' }}"
                                >
                                    <span
                                        t-out="this.state.data.day_counts[day.day_number] || 0"
                                    />
                                    <span
                                        t-if="this.state.data.gaps[day.day_number]"
                                        class="badge rounded-pill text-bg-danger ms-1"
                                        t-out="this.gapLabel(this.state.data.gaps[day.day_number])"
                                    />
                                </td>
                                <td />
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div
                    t-if="this.state.menu"
                    class="o_hr_shift_grid_menu shadow rounded bg-view"
                    t-attf-style="left: {{ this.state.menu.x }}px; top: {{ this.state.menu.y }}px;"
                    t-on-click.stop=""
                >
                    <div class="o_hr_shift_grid_menu_header text-muted small">
                        <b t-out="this.state.menu.employeeName" />
                        <span t-out="' — ' + this.state.menu.dayLabel" />
                        <div
                            t-if="this.state.menu.add"
                            class="fst-italic"
                        >Add a shift</div>
                    </div>
                    <button
                        t-foreach="this.state.data.templates"
                        t-as="template"
                        t-key="template.id"
                        class="o_hr_shift_grid_menu_item btn d-flex align-items-center w-100"
                        t-att-disabled="template.id === this.state.menu.templateId ? 'disabled' : undefined"
                        t-on-click="() => this.pickTemplate(template.id)"
                    >
                        <span
                            t-attf-class="o_tag o_badge badge rounded-pill o_tag_color_{{ template.color }}"
                        >
                            <b t-out="template.code" />
                        </span>
                        <span
                            class="ms-2 flex-grow-1 text-start"
                            t-out="template.name"
                        />
                        <span class="text-muted small ms-2" t-out="template.hours" />
                    </button>
                    <t t-if="this.state.menu.templateId">
                        <div class="dropdown-divider" />
                        <button
                            class="o_hr_shift_grid_menu_item btn d-flex align-items-center w-100 text-danger"
                            t-on-click="this.removeShift"
                        >
                            <span
                            class="oi me-2"
                            data-icon="close"
                            role="img"
                            aria-label="Remove"
                        />
                            Remove the shift
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
